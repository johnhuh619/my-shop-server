# ============================================
# mini-shop 환경변수 템플릿
# ============================================
# 이 파일을 복사하여 .env.prod 를 생성하세요:
#   cp .env.example .env.prod
#
# .env.prod 는 .gitignore에 의해 추적되지 않습니다.
# 절대 시크릿 값이 담긴 파일을 커밋하지 마세요.
# ============================================

# --- 민감 정보 (Secret Manager 등록 대상) ---
DB_URL=jdbc:postgresql://YOUR_SUPABASE_POOLER_HOST:6543/postgres
DB_USER=postgres.xxxx
DB_PASSWORD=
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379
JWT_SECRET=
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
INTERNAL_JOBS_AUTH_KEY=

# --- 비민감 설정 ---
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:3000
